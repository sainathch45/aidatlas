# Copy this to .env and fill in real values. .env itself is gitignored —
# never commit real keys.

# Same project as AidAtlas (reused deliberately, per the 2026-10-14
# decision) -- already Blaze-enabled with Vertex AI, Firestore, and
# Cloud Run configured. No new billing setup needed.
GCP_PROJECT_ID=ai-builder-cup-aidatlas

# Gemini via Vertex AI, same proven setup as aidatlas-api/.env.example --
# Application Default Credentials, no API key, global endpoint (confirmed
# the hard way there that gemini-3.8-flash only resolves on "global", not
# region-specific endpoints).
GEMINI_MODEL=gemini-3.8-flash
AGENT_PLATFORM_LOCATION=global

# Firestore collections live in the SAME project as AidAtlas's but under
# their own top-level collection names (listings/, companies/, demand/,
# matches/, forecasts/ -- PRD Section 10) so the two projects' data never
# collide despite sharing a GCP project.
