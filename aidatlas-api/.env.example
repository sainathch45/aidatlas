# Copy this to .env and fill in real values. .env itself is gitignored —
# never commit real keys.

# Gemini Developer API (free tier) — create at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Same GCP project backing Firebase/Firestore/BigQuery/Cloud Run
GCP_PROJECT_ID=ai-builder-cup-aidatlas

# Optional, only if/when we move a specific feature (Document AI, Vertex
# AI Search, Agent Engine/ADK) from the plain Gemini Developer API up to
# the Gemini Enterprise Agent Platform (the April 2026 rename of Vertex
# AI). That's a real upgrade path, not required for the MVP, and it
# needs Blaze billing already enabled regardless.
AGENT_PLATFORM_LOCATION=us-central1

# BigQuery dataset holding the HDX-derived tables, see bigquery/schema.sql
BIGQUERY_DATASET=crisis_allocator

# Google Maps JavaScript API key for the command-ops district map.
# Restrict this key (API + HTTP referrer) in the Cloud Console before
# shipping it anywhere public -- it has a monthly free credit but is not
# a no-cost service like the rest of this stack.
GOOGLE_MAPS_API_KEY=
