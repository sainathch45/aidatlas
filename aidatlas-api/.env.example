# Copy this to .env and fill in real values. .env itself is gitignored —
# never commit real keys.

# Gemini via Vertex AI / Gemini Enterprise Agent Platform -- NOT the
# plain Gemini Developer API. Switched after an independent review
# flagged the Developer API free tier's 20 requests/day cap (confirmed
# live) as the single biggest live-demo risk. No API key needed: auth
# is via Application Default Credentials (gcloud auth
# application-default login locally; the Cloud Run service's attached
# service account in prod). The calling identity needs
# roles/aiplatform.user on GCP_PROJECT_ID.
GEMINI_MODEL=gemini-3.8-flash

# Same GCP project backing Firebase/Firestore/BigQuery/Cloud Run
GCP_PROJECT_ID=ai-builder-cup-aidatlas

# Confirmed the hard way: gemini-3.8-flash is only served from the
# "global" Vertex AI endpoint, not region-specific ones like
# us-central1 -- that combination 404s even though auth and project
# access are both fine. Verify against
# https://docs.cloud.google.com/gemini-enterprise-agent-platform/resources/locations
# if swapping models later.
AGENT_PLATFORM_LOCATION=global

# BigQuery dataset holding the HDX-derived tables, see bigquery/schema.sql
BIGQUERY_DATASET=crisis_allocator

# Google Maps JavaScript API key for the command-ops district map.
# Restrict this key (API + HTTP referrer) in the Cloud Console before
# shipping it anywhere public -- it has a monthly free credit but is not
# a no-cost service like the rest of this stack.
GOOGLE_MAPS_API_KEY=
